@startuml context_and_domains
!theme plain
title Тёплый дом — поддомены и ограниченные контексты To-Be
skinparam componentStyle rectangle
skinparam shadowing false

package "Теплый дом" <<Домен>> {

    rectangle "Устройства" <<Поддомен>> as У #LightGreen {
      rectangle "Управление устройствами\n(регистрация, привязка к дому, конфигурация, \nподдерживаемые возможности, жизненный цикл,\nпротокольные адаптеры)" <<Контекст>> as УУ #LightBlue
    }

    rectangle "Мониторинг" <<Поддомен>> as ТЕЛ #LightGreen {
      rectangle "Телеметрия" <<Контекст>> as ХТЕЛ #LightBlue
    }

    rectangle "Отопление" <<Поддомен>> as О #LightGreen {
        rectangle "Управление отоплением\n(Команды и состояние отопления)" <<Контекст>> as УО #LightBlue
    }

    rectangle "Освещение" <<Поддомен>> as С #LightGreen {
        rectangle "Управление светом\n(Команды и состояние освещения)" <<Контекст>> as УС #LightBlue
    }

    rectangle "Ворота" <<Поддомен>> as В #LightGreen {
        rectangle "Управление воротами\n(Команды и состояние ворот)" <<Контекст>> as УВ #LightBlue
    }

    rectangle "Видеонаблюдение" <<Поддомен>> as ВН #LightGreen {
        rectangle "Видеонаблюдение\n(Команды и видео/аудио поток)" <<Контекст>> as УВН #LightBlue
    }

    rectangle "Автоматизация и Сценарии" <<Поддомен>> as АС #LightGreen {
        rectangle "Автоматизация\n(Правила, условия, триггеры \nи выполнение сценариев)" <<Контекст>> as ССТ #LightBlue
    }

    rectangle "Пользователи и права" <<Поддомен>> as ПП #LightGreen {
      rectangle "Идентификация и доступ\n(Пользователи, членство в домах, роли и права)" <<Контекст>> as ПКД #LightBlue
    }

    rectangle "Тарификация" <<Поддомен>> as Т #LightGreen {
        rectangle "Управление подписками" <<Контекст>> as ПТ #LightBlue
    }

}

' === Отношения ===

' Доменные контексты используют Устройства
УО -down-> УУ : Использует для\nуправления устройством
УВ -down-> УУ : Использует для\nуправления устройством
УС -down-> УУ : Использует для\nуправления устройством
УВН -down-> УУ : Использует для\nполучения списка устройств

' Сценарии отправляют команды в доменные контексты
ССТ -down-> УО : Отправляет команды\n(включить отопление)
ССТ -down-> УВ : Отправляет команды\n(открыть ворота)
ССТ -down-> УС : Отправляет команды\n(включить свет)
ССТ -down-> УВН : Изменяет настройки\nкамеры

' Измерения и подтверждения публикует интеграция с устройствами
УУ -down-> ХТЕЛ : Показания и\nсостояния устройств
УУ -down-> ССТ : События для\nтриггеров
УВН -down-> ХТЕЛ : Передает данные\nо работе видеонаблюдения

' Пользователи и права проверяются доменными контекстами
УО ..> ПКД : Проверяет права\nпользователя
УВ ..> ПКД : Проверяет права\nпользователя
ССТ ..> ПКД : Проверяет права\nна создание сценариев

' Тарификация проверяется Пользователями и правами
ПКД ..> ПТ : Проверяет подписку\nдома

@enduml
