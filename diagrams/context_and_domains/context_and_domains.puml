@startuml
!theme plain
skinparam componentStyle rectangle
skinparam shadowing false

package "Теплый дом" <<Домен>> {

    rectangle "Устройства" <<Поддомен>> as У #LightGreen {
      rectangle "Управление устройствами\n(жизненный цикл)" <<Контекст>> as УУ #LightBlue
    }

    rectangle "Стрим медиа" <<Поддомен>> as СМ #LightGreen {
      rectangle "Трансляция медиа потоков" <<Контекст>> as ТМ #LightBlue
    }

    rectangle "Телеметрия" <<Поддомен>> as ТЕЛ #LightGreen {
      rectangle "Хранение данных с устройств" <<Контекст>> as ХТЕЛ #LightBlue
    }

    rectangle "Отопление" <<Поддомен>> as О #LightGreen {
        rectangle "Управление отоплением" <<Контекст>> as УО #LightBlue
    }

    rectangle "Свет" <<Поддомен>> as С #LightGreen {
        rectangle "Управление светом" <<Контекст>> as УС #LightBlue
    }

    rectangle "Ворота" <<Поддомен>> as В #LightGreen {
        rectangle "Управление воротами" <<Контекст>> as УВ #LightBlue
    }

    rectangle "Видеонаблюдение" <<Поддомен>> as ВН #LightGreen {
        rectangle "Управление видеонаблюдением" <<Контекст>> as УВН #LightBlue
    }

    rectangle "Автоматизация и Сценарии" <<Поддомен>> as АС #LightGreen {
        rectangle "Создание сценариев для устройств" <<Контекст>> as ССТ #LightBlue
    }

    rectangle "Пользователи и права" <<Поддомен>> as ПП #LightGreen {
      rectangle "Проверка пользователей и их доступа" <<Контекст>> as ПКД #LightBlue
    }

    rectangle "Тарификация" <<Поддомен>> as Т #LightGreen {
        rectangle "Управление подписками" <<Контекст>> as ПТ #LightBlue
    }

}

' === Отношения ===

' Доменные контексты используют Устройства
УО -down-> УУ : Использует для\nуправления устройством
УВ -down-> УУ : Использует для\nуправления устройством
УС -down-> УУ : Использует для\nуправления устройством
УВН -down-> УУ : Использует для\nполучения списка устройств

' Сценарии отправляют команды в доменные контексты
ССТ -down-> УО : Отправляет команды\n(включить отопление)
ССТ -down-> УВ : Отправляет команды\n(открыть ворота)
ССТ -down-> УС : Отправляет команды\n(включить свет)
ССТ -down-> УВН : Отправляет команды\n(начать запись)

' Видеонаблюдение использует Стрим медиа
УВН -down-> ТМ : Использует для\nтрансляции видео/аудио

' Все доменные контексты отправляют данные в Телеметрию
УО -down-> ХТЕЛ : Передает данные\nо работе отопления
УВ -down-> ХТЕЛ : Передает данные\nо работе ворот
УС -down-> ХТЕЛ : Передает данные\nо работе освещения
УВН -down-> ХТЕЛ : Передает данные\nо работе видеонаблюдения

' Пользователи и права проверяются доменными контекстами
УО ..> ПКД : Проверяет права\nпользователя
УВ ..> ПКД : Проверяет права\nпользователя
ССТ ..> ПКД : Проверяет права\nна создание сценариев

' Тарификация проверяется Пользователями и правами
ПКД ..> ПТ : Проверяет активный\nтариф пользователя

@enduml