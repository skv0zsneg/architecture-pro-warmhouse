@startuml C4_Elements
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(user, "Пользователь", "Пользователь системы теплый дом.")
System(mainSystem, "Теплый Дом", "Дает возможность пользователям подключать устройства с общими протоколами, настраивать их, получать данные и автоматизировать.")
System_Ext(Module, "Модуль", "Дает возможность пользователям подключать устройства с общими протоколами, настраивать их, получать данные и автоматизировать.")

Rel(user, mainSystem, "Подключение и мониторинг устройств, настройка сценариев и автоматизация")
Rel(mainSystem, Module, "Отправка команд, запрос данных")
@enduml