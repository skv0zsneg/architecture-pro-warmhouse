@startuml c4_context
!include <C4/C4_Context>

title Тёплый дом — контекст исходного монолита (As-Is)
LAYOUT_TOP_DOWN()

Person(user, "Пользователь", "Удалённо управляет отоплением и проверяет температуру.")
Person(installer, "Специалист по подключению", "Устанавливает и настраивает оборудование.")
System(mainSystem, "Монолит «Тёплый дом»", "Go, Gin, PostgreSQL. Учёт датчиков и синхронное получение температуры; управление отоплением задано бизнес-описанием.")
System_Ext(modules, "Датчики и модули отопления", "Оборудование в доме. Доступ к показаниям через HTTP API.")

Rel(user, mainSystem, "Управление отоплением и просмотр температуры", "HTTP")
Rel(installer, mainSystem, "Регистрирует и настраивает датчики", "HTTP API")
Rel(installer, modules, "Устанавливает и подключает оборудование")
Rel(mainSystem, modules, "Запрашивает температуру; отправляет команды отопления по бизнес-описанию", "Синхронный HTTP")
@enduml
